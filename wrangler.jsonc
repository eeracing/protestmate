{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protestmate",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "80731427",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
